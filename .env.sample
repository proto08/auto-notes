# App
PORT=8000

# MySQL
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=mnemo
MYSQL_USER=mnemo
MYSQL_PASSWORD=password
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://mnemo:password@mysql:3306/mnemo

# RabbitMQ
RABBITMQ_DEFAULT_USER=mnemo
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
CELERY_BROKER_URL=amqp://mnemo:password@rabbitmq:5672//
CELERY_RESULT_BACKEND=db+mysql+pymysql://mnemo:password@mysql:3306/mnemo
